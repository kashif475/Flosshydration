# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Server-side only (scripts, Netlify Functions) ----
# Never prefix these with VITE_, or Vite will bundle them into the public website.

# GoHighLevel Private Integration token (Settings > Private Integrations)
GHL_TOKEN=

# GoHighLevel sub-account ID: the part after /location/ in the GHL URL
GHL_LOCATION_ID=

# ---- Public build settings (safe to expose; used by Vite at build time) ----

# Final public site URL, no trailing slash. Feeds canonical and social tags,
# robots.txt and sitemap.xml. Empty means the staging URL (vite.config.ts).
SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Public, not a secret.
# Empty means no analytics script is loaded at all.
VITE_GA_MEASUREMENT_ID=
